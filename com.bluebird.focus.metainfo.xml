<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.bluebird.focus</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Bluebird Focus</name>
  <summary>A calm deep work companion</summary>

  <description>
    <p>
      Bluebird Focus helps you stay in a state of deep, intentional work.
      Start a focus session, track how long you have been working, and reflect
      on how it went when you are done.
    </p>
    <ul>
      <li>Start named focus sessions, optionally linked to a task</li>
      <li>Visual coffee cup that steams while you focus</li>
      <li>Reflect on each session with a mood and optional note</li>
      <li>Review your full session history in the Focus Journal</li>
      <li>See a weekly summary of your focus patterns</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.bluebird.focus.desktop</launchable>

  <url type="homepage">https://github.com/YomenT/bluebird-focus</url>
